// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
//@version=6
// 일봉 · 일반 캔들(OHLC). 정배열 = MA10 > MA20 만 요구(20>50 불필요). 종가는 MA10·20·50 모두 위.
// 백테스트는 차트를 1D로 두는 것을 권장(하위 타임프레임에서는 일봉 미완성 구간 해석이 달라질 수 있음).
// 피라미딩은 전략 설정에서 조절 — 아래 USD 기준 수량 계산은 유지.
strategy(
     "SOXL Daily MA Pyramid (10/20 stack + $200/$5000)",
     overlay=true,
     pyramiding=100,
     initial_capital=100000,
     default_qty_type=strategy.fixed,
     default_qty_value=0,
     commission_type=strategy.commission.percent,
     commission_value=0.05,
     slippage=2)

// -----------------------------------------------------------------------------
// 입력
// -----------------------------------------------------------------------------
grpSize = "포지션 (USD)"
dailyEntryUsd = input.float(200.0, "일일 진입 상한 (USD)", minval=1, step=50, group=grpSize)
maxPositionUsd = input.float(5000.0, "누적 포지션 상한 (USD)", minval=100, step=100, group=grpSize)

grpRisk = "매도 (이평 대비 종가)"
ma5SellFac = input.float(0.99, "MA5 배수", minval=0.9, maxval=1.0, step=0.01, tooltip="종가 < MA5×값 → 기본 수량 1회 매도", group=grpRisk)
ma10SellFac = input.float(0.99, "MA10 배수", minval=0.9, maxval=1.0, step=0.01, tooltip="종가 < MA10×값 → 기본 수량 1회 매도", group=grpRisk)
ma20FullFac = input.float(0.99, "MA20 배수 (전량)", minval=0.9, maxval=1.0, step=0.01, tooltip="종가 < MA20×값 → 전량 매도", group=grpRisk)

grpGap = "갭"
openFloorFactor = input.float(0.97, "시가 대비 현재가 하한", minval=0.9, maxval=1.0, step=0.01, tooltip="현재가 > 시가 × 이 값 (약 -3% 이내)", group=grpGap)

// -----------------------------------------------------------------------------
// 일봉 일반 캔들 (차트가 일봉이 아니어도 일봉 시리즈로 계산)
// -----------------------------------------------------------------------------
string tfD = "1D"
float o_ = request.security(syminfo.tickerid, tfD, open, lookahead=barmerge.lookahead_off)
float c_ = request.security(syminfo.tickerid, tfD, close, lookahead=barmerge.lookahead_off)

float ma5 = request.security(syminfo.tickerid, tfD, ta.sma(close, 5), lookahead=barmerge.lookahead_off)
float ma10 = request.security(syminfo.tickerid, tfD, ta.sma(close, 10), lookahead=barmerge.lookahead_off)
float ma20 = request.security(syminfo.tickerid, tfD, ta.sma(close, 20), lookahead=barmerge.lookahead_off)
float ma50 = request.security(syminfo.tickerid, tfD, ta.sma(close, 50), lookahead=barmerge.lookahead_off)

rsi = request.security(syminfo.tickerid, tfD, ta.rsi(close, 14))

// -----------------------------------------------------------------------------
// 매수 조건 (모든 OHLC·MA는 위 일봉 security 시리즈)
// -----------------------------------------------------------------------------
bool bullPrev = c_[1] > o_[1]
bool bullPrev2 = c_[2] > o_[2]
float bodyPrev = math.abs(c_[1] - o_[1])
float bodyPrev2 = math.abs(c_[2] - o_[2])

bool ma5_above_ma20 = ma5 > ma20 * 1.02
bool ma10_above_ma20 = ma10 > ma20 * 1.015
bool price_above_all = c_ > ma10 and c_ > ma20 and c_ > ma50
bool two_green = bullPrev and bullPrev2
bool recent_body_larger = bodyPrev > bodyPrev2
bool above_prev_close = c_ > c_[1]
bool gap_ok = c_ > o_ * openFloorFactor

bool buySignal = (ma10_above_ma20 or ma5_above_ma20) and price_above_all and two_green and recent_body_larger and above_prev_close and gap_ok

// -----------------------------------------------------------------------------
// 매도 조건 (동시 평가: 부분 매도 트리거 개수 합산, MA20 전량은 별도)
// -----------------------------------------------------------------------------
bool bear1 = c_ < o_
bool bear2_streak = bear1 and c_[1] < o_[1]
bool bear3_streak = bear2_streak and c_[2] < o_[2]

bool sell_2bear = bear2_streak
bool sell_3bear = bear3_streak
bool sell_below_ma5 = c_ < ma5 * ma5SellFac
bool sell_below_ma10 = c_ < ma10 * ma10SellFac
bool sell_below_ma20_full = c_ < ma20 * ma20FullFac

bool overbought_sell = false
if ((c_[1] > ma50 * 1.3 and o_ < c_[1]*0.98)) and rsi < rsi[1] and rsi[1] > 70
    overbought_sell := true

// -----------------------------------------------------------------------------
// 피라미딩: 조건 충족 시 일일 USD 상한만큼 매수, 누적 USD 상한까지
// -----------------------------------------------------------------------------
float approxPosUsd = math.abs(strategy.position_size) * c_
float roomUsd = math.max(0.0, maxPositionUsd - approxPosUsd)
float addUsd = math.min(dailyEntryUsd, roomUsd)
bool canAdd = addUsd > 0 and addUsd >= c_ * 0.999
float addQty = addUsd / c_

// 매도 1회 분량 = 매수 기본 금액 기준 수량 (종가 기준)
float chunkSellQty = dailyEntryUsd / math.max(c_, syminfo.mintick)

float posSz = math.abs(strategy.position_size)
float avgPx = strategy.position_avg_price
float profitPct = avgPx > syminfo.mintick ? (c_ - avgPx) / avgPx * 100.0 : 0.0
string profitStr = str.tostring(profitPct, "#.##") + "%"

// 같은 일봉 바에서 중복 진입 방지
var int lastBuyDailyTime = na
int dailyTime = request.security(syminfo.tickerid, tfD, time_close, lookahead=barmerge.lookahead_off)
bool allowBuyToday = na(lastBuyDailyTime) or lastBuyDailyTime != dailyTime

// 부분 매도: 동시에 참인 규칙마다 1회 분량씩 합산 (상한: 보유 수량)
int partialTriggers = (overbought_sell ? 1 : 0) + (sell_2bear ? 1 : 0) + (sell_3bear ? 1 : 0) + (sell_below_ma5 ? 1 : 0) + (sell_below_ma10 ? 1 : 0)

float rawPartialQty = partialTriggers * chunkSellQty
float partialSellQty = math.min(posSz, rawPartialQty)

string partialTags = str.trim((overbought_sell ? "과매수 " : "") + (sell_2bear ? "2음 " : "") + (sell_3bear ? "3음 " : "") + (sell_below_ma5 ? "MA5 " : "") + (sell_below_ma10 ? "MA10 " : ""))

// -----------------------------------------------------------------------------
// 실행: 전량(MA20) 우선 → 부분 합산 매도 → 매수
// -----------------------------------------------------------------------------
if sell_below_ma20_full and posSz > 0
    strategy.close_all(comment=profitStr + "close all below MA20")
    lastBuyDailyTime := na
else if partialSellQty > 0 and chunkSellQty > 0
    strategy.order("SellPartial", strategy.short, qty=partialSellQty, comment= profitStr + " [" + partialTags + "]" )

if not sell_below_ma20_full and buySignal and allowBuyToday and canAdd and rsi < 85
    strategy.entry("PyramidLong", strategy.long, qty=addQty, comment="+" + str.tostring(addUsd, "#.##"))
    lastBuyDailyTime := dailyTime

// -----------------------------------------------------------------------------
// 시각화
// -----------------------------------------------------------------------------
plot(ma5, color=color.new(color.orange, 0), title="MA5")
plot(ma10, color=color.new(color.teal, 0), title="MA10")
plot(ma20, color=color.new(color.yellow, 0), title="MA20")
plot(ma50, color=color.new(color.green, 0), title="MA50")

bool anySell = sell_below_ma20_full or partialTriggers > 0
bgcolor(buySignal ? color.new(color.green, 92) : na, title="Buy setup")
bgcolor(anySell and posSz > 0 ? color.new(color.red, 91) : na, title="Sell setup")

plotshape(not sell_below_ma20_full and buySignal and canAdd and allowBuyToday, style=shape.triangleup, location=location.belowbar, size=size.tiny, color=color.lime, title="Buy add")
