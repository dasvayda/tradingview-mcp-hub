//@version=6
strategy("HUB DOGE EMA RSI ATR", overlay=true, pyramiding=0, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.1, slippage=2, process_orders_on_close=true, calc_on_every_tick=false, max_bars_back=5000)

// Tagged defaults are patched by the Python hub (HUB:<name>).
fastLen  = input.int(8, "Fast EMA", minval = 2, maxval = 80)                  // HUB:fast_ema
slowLen  = input.int(89, "Slow EMA", minval = 5, maxval = 200)                // HUB:slow_ema
rsiLen   = input.int(14, "RSI Length", minval = 2, maxval = 50)               // HUB:rsi_len
rsiLong  = input.int(58, "RSI Long Min", minval = 40, maxval = 80)            // HUB:rsi_long
rsiShort = input.int(45, "RSI Short Max", minval = 20, maxval = 60)           // HUB:rsi_short
atrLen   = input.int(14, "ATR Length", minval = 5, maxval = 50)               // HUB:atr_len
atrMult  = input.float(1.2, "ATR Stop Mult", minval = 0.5, step = 0.1)       // HUB:atr_mult
rrRatio  = input.float(1.5, "Reward Risk", minval = 0.5, step = 0.1)         // HUB:rr_ratio
allowLong  = input.bool(true, "Allow Long")                                  // HUB:allow_long
allowShort = input.bool(true, "Allow Short")                                 // HUB:allow_short

fastEma = ta.ema(close, fastLen)
slowEma = ta.ema(close, slowLen)
rsiVal  = ta.rsi(close, rsiLen)
atrVal  = ta.atr(atrLen)

bool crossUp   = ta.crossover(fastEma, slowEma)
bool crossDown = ta.crossunder(fastEma, slowEma)
bool longCond  = allowLong and crossUp and rsiVal >= rsiLong and barstate.isconfirmed
bool shortCond = allowShort and crossDown and rsiVal <= rsiShort and barstate.isconfirmed

var float longStop  = na
var float longLimit = na
var float shortStop = na
var float shortLimit = na

if longCond
    strategy.entry("Long", strategy.long)
    longStop  := close - atrVal * atrMult
    longLimit := close + atrVal * atrMult * rrRatio

if shortCond
    strategy.entry("Short", strategy.short)
    shortStop  := close + atrVal * atrMult
    shortLimit := close - atrVal * atrMult * rrRatio

if strategy.position_size > 0
    strategy.exit("Long Exit", from_entry = "Long", stop = longStop, limit = longLimit)

if strategy.position_size < 0
    strategy.exit("Short Exit", from_entry = "Short", stop = shortStop, limit = shortLimit)

plot(fastEma, "Fast EMA", color.new(color.aqua, 0))
plot(slowEma, "Slow EMA", color.new(color.orange, 0))
